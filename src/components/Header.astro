---
import { siteConfig } from '../config';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" id="top">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="NextGen Wargame home">
      <span class="brand-mark" aria-hidden="true">NG</span>
      <span class="brand-copy">
        <strong>NextGen Wargame</strong>
        <small>Decision training systems</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a class="header-cta" href={`mailto:${siteConfig.author.email}?subject=Military training or exercise problem`}>
      Discuss a problem
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="visually-hidden">Toggle navigation</span>
      <span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    {siteConfig.nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href={`mailto:${siteConfig.author.email}?subject=Military training or exercise problem`}>Discuss a problem</a>
  </nav>
</header>

<script>
  const setupMenu = () => {
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-nav');
    if (!toggle || !menu || toggle.dataset.ready === 'true') return;

    toggle.dataset.ready = 'true';
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.hidden = expanded;
    });
  };

  setupMenu();
  document.addEventListener('astro:page-load', setupMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(18px);
  }

  .header-shell {
    width: min(100% - 3rem, 1320px);
    min-height: 92px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    width: fit-content;
  }

  .brand:hover { color: var(--color-text); }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .brand-copy { display: grid; gap: 0.1rem; }
  .brand-copy strong { font-size: 0.9rem; letter-spacing: -0.01em; }
  .brand-copy small { color: var(--color-text-muted); font-size: 0.68rem; letter-spacing: 0.04em; }

  .desktop-nav { display: flex; align-items: center; gap: 2rem; }
  .nav-link { color: var(--color-text-secondary); font-size: 0.9rem; font-weight: 600; }
  .nav-link:hover, .nav-link--active { color: var(--color-text); }
  .nav-link--active { text-decoration: underline; text-decoration-color: var(--color-highlight); text-underline-offset: 0.5rem; }

  .header-cta {
    justify-self: end;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .header-cta:hover { color: var(--color-bg); background: var(--color-accent-dark); }

  .menu-toggle, .mobile-nav { display: none; }

  @media (max-width: 840px) {
    .header-shell { grid-template-columns: 1fr auto; min-height: 76px; width: min(100% - 2rem, 1320px); }
    .desktop-nav, .header-cta { display: none; }
    .menu-toggle {
      display: grid;
      width: 44px;
      height: 44px;
      place-content: center;
      gap: 6px;
      border: 1px solid var(--color-border);
      border-radius: 50%;
      background: transparent;
    }
    .menu-toggle span:not(.visually-hidden) { display: block; width: 18px; height: 1px; background: var(--color-text); }
    .mobile-nav { padding: 0 1rem 1rem; border-top: 1px solid var(--color-border); }
    .mobile-nav:not([hidden]) { display: grid; }
    .mobile-nav a { color: var(--color-text); padding: 0.9rem 0.25rem; border-bottom: 1px solid var(--color-border-subtle); }
  }
</style>
