---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('workbenchNotes')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <SEO slot="head" title="AI Workbench" description="Practical notes on AI models, governed workflows, verification, maintenance, translation, and tool selection." type="website" />
  <main class="workbench-page shell">
    <header class="workbench-hero">
      <p class="eyebrow">AI Workbench</p><h1>Methods, tools,<br /><span>and operating lessons.</span></h1>
      <div class="hero-lower"><p>Short technical notes on how AI-assisted work is framed, built, checked, maintained, and sometimes discarded.</p><div><strong>{notes.length}</strong><span>Workbench notes</span></div></div>
    </header>
    <section class="note-grid" aria-label="AI Workbench notes">
      {notes.map((note, index) => <article class="note-card"><div class="note-rail"><span>{String(index + 1).padStart(2, '0')}</span><span>AI Workbench</span></div><div class="note-body"><div class="tags">{note.data.tags?.slice(0, 2).map((tag) => <span>{tag}</span>)}</div><h2><a href={`/model-workbench/${note.id}`}>{note.data.title}</a></h2><p>{note.data.description}</p><a class="read-link" href={`/model-workbench/${note.id}`}>Read note ↗</a></div></article>)}
    </section>
    <aside class="field-link"><div><p class="eyebrow">CADE narrative</p><h2>For the story behind the exercise, read Field Notes.</h2></div><a href="/field-notes">Open Field Notes <span>↗</span></a></aside>
  </main>
  <style>
    .shell { width: min(100% - 3rem, 1180px); margin-inline: auto; } .eyebrow { margin: 0; color: var(--color-accent); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
    .workbench-hero { padding-block: clamp(4rem, 9vw, 8rem) 4rem; } .workbench-hero h1 { font-size: clamp(4rem, 8.5vw, 7.5rem); line-height: 0.88; letter-spacing: -0.065em; margin: 1.5rem 0 4rem; } .workbench-hero h1 span { color: transparent; -webkit-text-stroke: 1.5px var(--color-text); } .hero-lower { display: grid; grid-template-columns: 1fr auto; gap: 4rem; border-top: 1px solid var(--color-border); padding-top: 2rem; align-items: end; } .hero-lower p { max-width: 42rem; font-size: 1.15rem; } .hero-lower div { display: grid; border-left: 1px solid var(--color-border); padding-left: 1.5rem; min-width: 150px; } .hero-lower strong { font-size: 2.5rem; } .hero-lower span { color: var(--color-text-muted); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.07em; }
    .note-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 5rem; } .note-card { min-height: 300px; display: grid; grid-template-columns: 54px 1fr; border: 1px solid var(--color-border); border-radius: 1.5rem; overflow: hidden; background: var(--color-bg-elevated); } .note-rail { border-right: 1px solid var(--color-border); padding: 1.2rem 0.9rem; display: flex; flex-direction: column; justify-content: space-between; align-items: center; color: var(--color-text-muted); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; } .note-rail span:last-child { writing-mode: vertical-rl; transform: rotate(180deg); } .note-body { padding: 1.5rem; display: flex; flex-direction: column; } .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; } .tags span { color: var(--color-text-muted); border: 1px solid var(--color-border); border-radius: 999px; padding: 0.25rem 0.55rem; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; } .note-body h2 { font-size: clamp(1.3rem, 2.3vw, 1.8rem); line-height: 1.1; margin: 2rem 0 1rem; } .note-body h2 a, .read-link { color: var(--color-text); } .note-body p { font-size: 0.9rem; } .read-link { margin-top: auto; font-size: 0.76rem; font-weight: 700; } .note-card:hover { border-color: var(--color-text-muted); transform: translateY(-3px); box-shadow: var(--shadow-md); }
    .field-link { margin-bottom: 4rem; border-radius: 2rem; padding: clamp(2.5rem, 6vw, 5rem); background: #d8d2c3; display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; } .field-link h2 { max-width: 14ch; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -0.045em; margin-top: 1rem; } .field-link a { display: flex; gap: 3rem; border-radius: 999px; padding: 1rem 1.25rem; background: var(--color-text); color: var(--color-bg); font-size: 0.82rem; font-weight: 700; }
    @media (prefers-reduced-motion: no-preference) { .note-card { transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease; } } @media (max-width: 760px) { .note-grid { grid-template-columns: 1fr; } .hero-lower, .field-link { grid-template-columns: 1fr; } } @media (max-width: 560px) { .shell { width: min(100% - 2rem, 1180px); } .workbench-hero h1 { font-size: clamp(3.7rem, 17vw, 5.2rem); } .workbench-hero h1 span { -webkit-text-stroke-width: 1px; } .note-card { min-height: 270px; } .field-link { padding: 2rem; border-radius: 1.5rem; } }
  </style>
</BaseLayout>
