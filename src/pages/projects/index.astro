---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';

const systems = (await getCollection('projects')).sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;
  return b.data.year - a.data.year;
});

const systemType = (order?: number) => {
  if (order === 1) return 'Capstone exercise';
  if (order === 2) return 'Core production pipeline';
  return 'Supporting workflow';
};
---

<BaseLayout>
  <SEO slot="head" title={pagesConfig.projects.title} description={pagesConfig.projects.description} type="website" />

  <main class="systems-page">
    <header class="systems-hero shell">
      <p class="eyebrow">NextGen systems</p>
      <h1>Built as one<br /><span>operating stack.</span></h1>
      <div class="hero-detail">
        <p class="lead">CADE is the training system. Orders Production and the Controller Package Generator supply the governed source and runtime products that make it repeatable.</p>
        <dl>
          <div><dt>01</dt><dd>Capstone</dd></div>
          <div><dt>02</dt><dd>Production</dd></div>
          <div><dt>03</dt><dd>Delivery</dd></div>
        </dl>
      </div>
    </header>

    <section class="stack-map" aria-label="System relationship">
      <div class="shell stack-grid">
        <div>
          <span>Source truth</span>
          <strong>Orders Production</strong>
          <p>Builds and validates OPORD-quality source material.</p>
        </div>
        <span class="connector" aria-hidden="true">→</span>
        <div class="stack-focus">
          <span>Decision engine</span>
          <strong>CADE</strong>
          <p>Turns context into choices, consequences, and learning.</p>
        </div>
        <span class="connector" aria-hidden="true">→</span>
        <div>
          <span>Runtime delivery</span>
          <strong>Controller Package</strong>
          <p>Gives controllers one coherent execution package.</p>
        </div>
      </div>
    </section>

    <section class="system-catalog shell">
      <div class="catalog-heading">
        <p class="eyebrow">System catalog</p>
        <h2>Three layers. One training outcome.</h2>
      </div>

      <div class="catalog-list">
        {systems.map((system, index) => (
          <article class="system-card">
            <div class="system-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="system-main">
              <span>{systemType(system.data.order)}</span>
              <h3>{system.data.title}</h3>
              <p>{system.data.outcomeSummary}</p>
            </div>
            <dl class="system-facts">
              <div><dt>Role</dt><dd>{system.data.role}</dd></div>
              <div><dt>Status</dt><dd>{system.data.status}</dd></div>
              <div><dt>Year</dt><dd>{system.data.year}</dd></div>
            </dl>
            <div class="system-actions">
              <a href={`/projects/${system.id}`}>Review case study <span>↗</span></a>
              <a href={`/projects/${system.id}/decisions`}>Decision record →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="selection shell">
      <p class="eyebrow">Where to start</p>
      <h2>Start with CADE for the training model. Follow the supporting systems when you need production detail.</h2>
      <a href="/projects/cade">Open the CADE case study <span>↗</span></a>
    </section>
  </main>

  <style>
    .shell { width: min(100% - 3rem, 1320px); margin-inline: auto; }
    .eyebrow { margin: 0; color: var(--color-accent); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
    .systems-page { overflow: hidden; }

    .systems-hero { padding-block: clamp(4rem, 9vw, 8rem) 5rem; }
    .systems-hero h1 { font-size: clamp(4.5rem, 11vw, 10rem); line-height: 0.82; letter-spacing: -0.07em; font-weight: 600; margin: 1.5rem 0 4rem; }
    .systems-hero h1 span { color: transparent; -webkit-text-stroke: 2px var(--color-text); }
    .hero-detail { border-top: 1px solid var(--color-border); padding-top: 2.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; }
    .hero-detail .lead { max-width: 42rem; font-size: clamp(1.15rem, 2vw, 1.55rem); line-height: 1.55; margin: 0; }
    .hero-detail dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; }
    .hero-detail dl div { border-left: 1px solid var(--color-border); padding-left: 1.25rem; }
    .hero-detail dt { font-size: 1.4rem; font-weight: 700; }
    .hero-detail dd { color: var(--color-text-muted); font-size: 0.75rem; margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.06em; }

    .stack-map { background: #17211d; color: #f7f4eb; padding-block: 3.5rem; }
    .stack-grid { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 2rem; align-items: center; }
    .stack-grid > div { min-height: 170px; border: 1px solid #46524c; border-radius: 1.25rem; padding: 1.5rem; display: flex; flex-direction: column; }
    .stack-grid .stack-focus { background: var(--color-highlight); border-color: var(--color-highlight); color: #17211d; }
    .stack-grid span:not(.connector) { color: #abb6b0; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
    .stack-grid .stack-focus span { color: #41533e; }
    .stack-grid strong { font-size: 1.3rem; margin: 1.5rem 0 0.5rem; }
    .stack-grid p { color: #c8d0cb; font-size: 0.88rem; line-height: 1.55; margin-top: auto; }
    .stack-grid .stack-focus p { color: #344132; }
    .connector { color: var(--color-highlight); font-size: 1.5rem; }

    .system-catalog { padding-block: clamp(5rem, 9vw, 8rem); }
    .catalog-heading { display: grid; grid-template-columns: 0.4fr 1.6fr; gap: 3rem; margin-bottom: 4rem; }
    .catalog-heading h2 { max-width: 14ch; font-size: clamp(2.8rem, 6vw, 5.5rem); line-height: 0.98; letter-spacing: -0.055em; margin: 0; }
    .catalog-list { border-top: 1px solid var(--color-border); }
    .system-card { display: grid; grid-template-columns: 70px 1.2fr 0.8fr auto; gap: 2rem; padding-block: 3rem; border-bottom: 1px solid var(--color-border); align-items: start; }
    .system-index, .system-main > span, .system-facts dt { color: var(--color-text-muted); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
    .system-main h3 { font-size: clamp(1.8rem, 3vw, 2.8rem); margin: 0.6rem 0 1rem; letter-spacing: -0.035em; }
    .system-main p { max-width: 42rem; margin: 0; }
    .system-facts { margin: 0; display: grid; gap: 1rem; }
    .system-facts div { border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 0.75rem; }
    .system-facts dd { color: var(--color-text); font-size: 0.82rem; margin-top: 0.25rem; text-transform: capitalize; }
    .system-actions { display: grid; gap: 0.75rem; justify-items: end; }
    .system-actions a:first-child { display: flex; justify-content: space-between; gap: 2rem; min-width: 190px; border-radius: 999px; padding: 0.85rem 1rem; background: var(--color-text); color: var(--color-bg); font-size: 0.8rem; font-weight: 700; }
    .system-actions a:last-child { color: var(--color-text); font-size: 0.75rem; font-weight: 700; }

    .selection { margin-bottom: 4rem; background: #d8d2c3; border-radius: 2rem; padding: clamp(3rem, 7vw, 6rem); }
    .selection h2 { max-width: 18ch; font-size: clamp(2.3rem, 5vw, 4.8rem); line-height: 1; letter-spacing: -0.05em; margin: 1.25rem 0 2.5rem; }
    .selection a { display: inline-flex; gap: 3rem; border-radius: 999px; padding: 1rem 1.3rem; background: var(--color-text); color: var(--color-bg); font-size: 0.85rem; font-weight: 700; }

    @media (max-width: 960px) {
      .hero-detail, .catalog-heading { grid-template-columns: 1fr; }
      .stack-grid { grid-template-columns: 1fr; }
      .connector { transform: rotate(90deg); justify-self: center; }
      .system-card { grid-template-columns: 44px 1fr; }
      .system-facts, .system-actions { grid-column: 2; }
      .system-actions { justify-items: start; }
    }

    @media (max-width: 560px) {
      .shell { width: min(100% - 2rem, 1320px); }
      .systems-hero h1 { font-size: clamp(4rem, 21vw, 6rem); }
      .systems-hero h1 span { -webkit-text-stroke-width: 1px; }
      .hero-detail dl { margin-top: 1rem; }
      .stack-map { padding-block: 2rem; }
      .system-card { padding-block: 2rem; gap: 1rem; }
      .selection { width: calc(100% - 2rem); padding: 2rem; border-radius: 1.5rem; }
    }
  </style>
</BaseLayout>
