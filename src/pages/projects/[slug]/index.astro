---
/**
 * Project Detail Page
 * 
 * Dynamic route that displays each project in the Project Proof format first,
 * with deeper case-study material available below the proof layer.
 * 
 * Proof Structure:
 * 1. The Problem
 * 2. The Design Move
 * 3. What I Built
 * 4. Supporting Tools
 * 5. Proof It Worked
 * 6. What This Shows
 * 
 * Features:
 * - Static path generation for all project entries
 * - Structured case study presentation
 * - Impact metrics grid (when available)
 * - Reading time calculation
 * - Structured data for SEO
 * - Optional additional markdown content
 * - Scroll-to-top functionality
 * - Related content navigation
 * - Back navigation to projects list
 * 
 * Route: /projects/[slug]
 * 
 * @page
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import SEO from '../../../components/SEO.astro';
import StructuredData from '../../../components/StructuredData.astro';
import ScrollToTop from '../../../components/ScrollToTop.astro';
import BackLink from '../../../components/BackLink.astro';
import RelatedContent from '../../../components/RelatedContent.astro';
import ImpactMetrics from '../../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import { calculateReadingTime, formatReadingTime } from '../../../utils/readingTime';

/**
 * Generates static paths for all project entries
 * 
 * Queries the projects content collection and creates a route for each entry
 * using the entry ID as the slug parameter.
 * 
 * @returns Array of path objects with params
 */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;

/**
 * Retrieves the specific project entry by slug
 * 
 * Redirects to 404 if the project is not found.
 */
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

// Render the content (v6-compatible method)
const { Content } = await render(project);

const {
  title,
  heroImage,
  heroImageAlt,
  role,
  year,
  duration,
  teamSize,
  outcomeSummary,
  overview,
  problem,
  designMove,
  systemBuilt,
  supportingTools,
  proof,
  transferableSkill,
  constraints,
  approach,
  aiOperatorSkills,
  turnRhythm,
  architectureModules,
  keyDecisions,
  techStack,
  impact,
  learnings,
  evidence,
  fitCriteria,
  riskControls,
  boundaries,
  relatedProjects,
  relatedDecisions,
  pipelineSkills,
  status,
} = project.data;

function skillColor(name: string): string {
  const colors: Record<string, string> = {
    'opord-writer': '#3b82f6',
    'red-team': '#ef4444',
    'order-release': '#22c55e',
  };
  return colors[name] ?? 'var(--color-accent)';
}

// Status display configuration
const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
};
const statusInfo = statusConfig[status || 'completed'];
const isCapstone = project.id === 'cade' || project.data.featured;
const portfolioLabel = (() => {
  const ord = project.data.order;
  if (ord === 1) return 'Capstone project';
  if (ord === 2) return 'Core pipeline';
  return 'Supporting system';
})();
const portfolioSummary = isCapstone
  ? 'CADE is the flagship NextGen Wargame case study. It demonstrates the full operating model: source truth, turn rhythm, adjudication structure, controller usability, and execution evidence.'
  : 'This project is part of the wider NextGen Wargame system. It strengthens the production chain around CADE by improving source-package completeness, controller usability, or multi-document workflow reliability.';
const proofItems = proof ?? evidence ?? [];
const designMoveText = designMove ?? approach;
const systemBuiltText = systemBuilt ?? overview;
const transferableSkillText = transferableSkill ?? impact.qualitative;

/**
 * Calculates reading time from all case study content
 * 
 * Combines all text sections including overview, problem, approach, decisions,
 * impact, learnings, and optional markdown body to estimate total reading time.
 */
const allText = [
  overview,
  problem,
  designMove,
  systemBuilt,
  transferableSkill,
  approach,
  ...(supportingTools ?? []).map(tool => `${tool.name} ${tool.purpose}`),
  ...constraints,
  ...(aiOperatorSkills ?? []),
  ...(turnRhythm ?? []).map(item => `${item.phase} ${item.purpose}`),
  ...(architectureModules ?? []).map(module => `${module.name} ${module.purpose} ${module.operatorSkill}`),
  ...keyDecisions.map(d => `${d.decision} ${d.reasoning} ${d.alternatives?.join(' ') || ''}`),
  impact.qualitative,
  ...(proof ?? []).map(item => `${item.label} ${item.result}`),
  ...(evidence ?? []).map(item => `${item.label} ${item.result}`),
  ...(fitCriteria ?? []),
  ...(riskControls ?? []).map(item => `${item.risk} ${item.control}`),
  ...(boundaries ?? []),
  ...learnings,
  project.body || '',
].join(' ');
const readingTime = formatReadingTime(calculateReadingTime(allText));
---

<BaseLayout>
  <SEO 
    slot="head"
    title={`${title} - Case Study`}
    description={outcomeSummary}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{
      title,
      outcomeSummary,
      problem,
      impact: impact.qualitative,
      techStack,
      year,
    }}
  />

  <main class="case-study">
    <!-- Case Study Header -->
    <header class="case-study-header">
      <div class="header-badges">
        <span class:list={['portfolio-badge', { 'portfolio-badge--support': !isCapstone }]}>
          {portfolioLabel}
        </span>
        {status && status !== 'completed' && (
          <span class:list={['status-badge', statusInfo.class]}>
            {statusInfo.label}
          </span>
        )}
      </div>
      <h1>{title}</h1>
      <div class="case-study-meta">
        <span class="meta-item">{role}</span>
        <span class="meta-separator">·</span>
        <span class="meta-item">{year}</span>
        {duration && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-item">{duration}</span>
          </>
        )}
        {teamSize && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-item">{teamSize} {teamSize === 1 ? 'person' : 'people'}</span>
          </>
        )}
        <span class="meta-separator">·</span>
        <span class="meta-item">{readingTime}</span>
      </div>
      <p class="outcome-summary">{outcomeSummary}</p>
      {heroImage && (
        <Image
          class="case-study-hero-image"
          src={heroImage}
          alt={heroImageAlt ?? `${title} in execution`}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 900px) 100vw, 900px"
          loading="eager"
        />
      )}
    </header>

    <ProjectTabs projectSlug={slug!} />

    <section class="portfolio-context" aria-label="Portfolio context">
      <div class="portfolio-context__intro">
        <span>Where this fits</span>
        <h2>{isCapstone ? 'This is the system centerpiece.' : 'This is part of the supporting stack.'}</h2>
        <p>{portfolioSummary}</p>
      </div>
      <div class="portfolio-context__links">
        {!isCapstone && (
          <a href="/projects/cade" class="context-link">
            <strong>See the capstone</strong>
            <span>Read how CADE uses this supporting workflow in execution.</span>
          </a>
        )}
        {isCapstone && (
          <a href="/field-notes" class="context-link">
            <strong>Read the field notes</strong>
            <span>Follow the working story behind CADE: background, design choices, mistakes, and lessons.</span>
          </a>
        )}
        <a href="/about" class="context-link">
          <strong>See the method</strong>
          <span>Review the governed AI workflow principles behind the project system.</span>
        </a>
        <a href="/projects" class="context-link">
          <strong>See the portfolio</strong>
          <span>Compare this project against the rest of the NextGen Wargame stack.</span>
        </a>
      </div>
    </section>

    <section class="project-proof" aria-labelledby="project-proof-heading">
      <div class="proof-intro">
        <span>Project Proof</span>
        <h2 id="project-proof-heading">The useful version first.</h2>
        <p>Every project is framed as a problem, design move, built system, supporting workflow, evidence set, and transferable skill.</p>
      </div>

      <div class="proof-sections">
        <article class="proof-section proof-section--wide">
          <span class="proof-label">01 · The Problem</span>
          <p>{problem}</p>
        </article>

        <article class="proof-section">
          <span class="proof-label">02 · The Design Move</span>
          <p>{designMoveText}</p>
        </article>

        <article class="proof-section">
          <span class="proof-label">03 · What I Built</span>
          <p>{systemBuiltText}</p>
        </article>

        <article class="proof-section proof-section--wide">
          <span class="proof-label">04 · Supporting Tools</span>
          {supportingTools && supportingTools.length > 0 ? (
            <div class="supporting-tools-list">
              {supportingTools.map((tool) => (
                <div class="supporting-tool">
                  <strong>{tool.name}</strong>
                  <p>{tool.purpose}</p>
                </div>
              ))}
            </div>
          ) : (
            <p>{portfolioSummary}</p>
          )}
        </article>

        {proofItems.length > 0 && (
          <article class="proof-section proof-section--wide">
            <span class="proof-label">05 · Proof It Worked</span>
            <div class="evidence-list evidence-list--proof">
              {proofItems.map((item) => (
                <div class="evidence-item">
                  <strong>{item.label}</strong>
                  <p>{item.result}</p>
                </div>
              ))}
            </div>
          </article>
        )}

        <article class="proof-section proof-section--wide">
          <span class="proof-label">06 · What This Shows</span>
          <p>{transferableSkillText}</p>
        </article>
      </div>
    </section>

    {pipelineSkills && pipelineSkills.length > 0 && (
      <>
        <section class="goal-callout" aria-label="Pipeline goal">
          <div class="goal-stat">90%</div>
          <div class="goal-detail">
            <strong>first-draft target</strong>
            <div class="goal-chips">
              <span>Exercise OPORDs</span>
              <span>Brigade and below</span>
              <span>FM 5-0 / FM 6-0 aligned</span>
              <span>Techniques apply to real-world orders</span>
            </div>
          </div>
        </section>

        <section class="pipeline-skills" aria-labelledby="pipeline-skills-heading">
          <div class="pipeline-skills-intro">
            <span>Pipeline Skills</span>
            <h2 id="pipeline-skills-heading">Three stages. One governed workflow.</h2>
            <p>Each skill has a specific job in the sequence. None is a prompt wrapper — each enforces constraints AI generation cannot self-impose without them.</p>
          </div>

          {pipelineSkills.map((skill, index) => (
            <>
              <div class="skill-card" style={`border-left-color: ${skillColor(skill.name)}`}>
                <div class="skill-card__left">
                  <span class="skill-stage">{skill.stage}</span>
                  <h3 class="skill-name">{skill.name}</h3>
                  {skill.crossProject && (
                    <span class="cross-project-badge">cross-project skill</span>
                  )}
                  <p class="skill-what">{skill.whatItDoes}</p>
                  <div class="skill-modes">
                    {skill.modes.map((mode) => (
                      <span class="mode-chip">{mode}</span>
                    ))}
                  </div>
                </div>
                <div class="skill-card__right">
                  <span class="insight-label">{skill.insightLabel}</span>
                  <p class="insight-text">{skill.insightText}</p>
                </div>
                <div class="skill-card__action">
                  <button class="brief-btn" aria-disabled="true" disabled>Brief ↓</button>
                </div>
              </div>
              {index < pipelineSkills.length - 1 && (
                <div class="skill-arrow" aria-hidden="true">↓</div>
              )}
            </>
          ))}
        </section>
      </>
    )}

    <section class="case-study-section">
      <h2>Deeper Detail</h2>
      <p>{overview}</p>
    </section>

    <section class="case-study-section">
      <h2>Operating Constraints</h2>
      <ul class="constraints-list">
        {constraints.map((constraint) => (
          <li>{constraint}</li>
        ))}
      </ul>
    </section>

    <section class="case-study-section">
      <h2>Production Approach</h2>
      <p>{approach}</p>
    </section>

    {aiOperatorSkills && aiOperatorSkills.length > 0 && (
      <section class="case-study-section">
        <h2>AI Operator Skill Demonstrated</h2>
        <ul class="operator-skill-list">
          {aiOperatorSkills.map((skill) => (
            <li>{skill}</li>
          ))}
        </ul>
      </section>
    )}

    {turnRhythm && turnRhythm.length > 0 && (
      <section class="case-study-section">
        <h2>Turn Rhythm</h2>
        <div class="rhythm-list">
          {turnRhythm.map((item, index) => (
            <article class="rhythm-item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.phase}</h3>
              <p>{item.purpose}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {architectureModules && architectureModules.length > 0 && (
      <section class="case-study-section">
        <h2>Product Architecture</h2>
        <div class="architecture-grid">
          {architectureModules.map((module, index) => (
            <article class="architecture-card">
              <span class="module-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{module.name}</h3>
              <p>{module.purpose}</p>
              <strong>{module.operatorSkill}</strong>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Key Decisions Section -->
    <section class="case-study-section">
      <h2>Key Decisions</h2>
      <div class="decisions-list">
        {keyDecisions.map((decision) => (
          <div class="decision-item">
            <h3 class="decision-title">{decision.decision}</h3>
            <div class="decision-reasoning">
              <strong>Reasoning:</strong>
              <p>{decision.reasoning}</p>
            </div>
            {decision.alternatives && decision.alternatives.length > 0 && (
              <div class="decision-alternatives">
                <strong>Alternatives considered:</strong>
                <ul>
                  {decision.alternatives.map((alt) => (
                    <li>{alt}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack Section -->
    <section class="case-study-section">
      <h2>Tech Stack</h2>
      <ul class="tech-stack-list">
        {techStack.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </section>

    <!-- Result/Impact Section -->
    <section class="case-study-section">
      <h2>Result & Impact</h2>
      
      {/* Display metrics with visualization */}
      {impact.metrics && impact.metrics.length > 0 && (
        <ImpactMetrics metrics={impact.metrics} />
      )}
      
      <p class="impact-qualitative">{impact.qualitative}</p>
    </section>

    {evidence && evidence.length > 0 && proof && proof.length > 0 && (
      <section class="case-study-section">
        <h2>Additional Evidence Signals</h2>
        <div class="evidence-list">
          {evidence.map((item) => (
            <div class="evidence-item">
              <strong>{item.label}</strong>
              <p>{item.result}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {fitCriteria && fitCriteria.length > 0 && (
      <section class="case-study-section">
        <h2>{isCapstone ? 'Where CADE Fits' : 'Where This Fits'}</h2>
        <ul class="constraints-list">
          {fitCriteria.map((criterion) => (
            <li>{criterion}</li>
          ))}
        </ul>
      </section>
    )}

    {riskControls && riskControls.length > 0 && (
      <section class="case-study-section">
        <h2>Designed Against Failure Modes</h2>
        <div class="risk-list">
          {riskControls.map((item) => (
            <article class="risk-item">
              <strong>{item.risk}</strong>
              <p>{item.control}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {boundaries && boundaries.length > 0 && (
      <section class="case-study-section">
        <h2>Boundaries</h2>
        <ul class="constraints-list">
          {boundaries.map((boundary) => (
            <li>{boundary}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Learnings Section -->
    <section class="case-study-section">
      <h2>Learnings</h2>
      <ul class="learnings-list">
        {learnings.map((learning) => (
          <li>{learning}</li>
        ))}
      </ul>
    </section>

    <!-- Additional MDX Content (if any) -->
    {Content && (
      <section class="case-study-content">
        <Content />
      </section>
    )}

    <!-- Related Content -->
    <RelatedContent 
      relatedProjects={relatedProjects} 
      relatedDecisions={relatedDecisions}
      currentProjectSlug={slug!}
    />

    <BackLink href="/projects" text="All systems" />
  </main>

  <ScrollToTop />

  <style>
    .case-study {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .case-study-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .case-study-hero-image {
      display: block;
      width: 100%;
      height: auto;
      margin-top: 2.5rem;
      border-radius: 1.5rem;
    }

    .header-badges {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .header-badges:empty {
      display: none;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.625rem;
      border-radius: 4px;
    }

    .portfolio-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.3rem 0.625rem;
      border-radius: 999px;
      background: rgba(59, 130, 246, 0.12);
      color: #60a5fa;
    }

    .portfolio-badge--support {
      background: rgba(251, 191, 36, 0.12);
      color: #fbbf24;
    }

    .status--ongoing {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }

    .status--archived {
      background: rgba(115, 115, 115, 0.15);
      color: var(--color-text-muted);
    }

    .case-study-header h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .case-study-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
    }

    .meta-separator {
      opacity: 0.5;
    }

    .outcome-summary {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
    }

    .case-study-section {
      margin-bottom: 3rem;
    }

    .portfolio-context {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
      gap: 1rem;
      margin-bottom: 3rem;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background:
        linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(251, 191, 36, 0.05)),
        var(--color-bg-secondary);
    }

    .portfolio-context__intro span {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
    }

    .portfolio-context__intro h2 {
      font-size: 1.5rem;
      line-height: 1.15;
      margin-bottom: 0.75rem;
    }

    .portfolio-context__intro p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .portfolio-context__links {
      display: grid;
      gap: 0.75rem;
    }

    .context-link {
      display: block;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-bg);
      text-decoration: none;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .context-link:hover {
      border-color: var(--color-text-muted);
      transform: translateY(-1px);
    }

    .context-link strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.35rem;
    }

    .context-link span {
      display: block;
      color: var(--color-text-secondary);
      line-height: 1.55;
      font-size: 0.95rem;
    }

    .case-study-section h2 {
      font-size: 1.75rem;
      margin-bottom: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .case-study-section p {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .project-proof {
      margin-bottom: 3.5rem;
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background:
        radial-gradient(circle at top left, rgba(251, 191, 36, 0.12), transparent 34rem),
        linear-gradient(135deg, rgba(59, 130, 246, 0.08), transparent),
        var(--color-bg-secondary);
    }

    .proof-intro {
      max-width: 640px;
      margin-bottom: 1.5rem;
    }

    .proof-intro span,
    .proof-label {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .proof-intro h2 {
      margin: 0.6rem 0 0.65rem;
      font-size: 2rem;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .proof-intro p {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .proof-sections {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .proof-section {
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: rgba(10, 15, 25, 0.38);
    }

    .proof-section--wide {
      grid-column: 1 / -1;
    }

    .proof-section p {
      margin-top: 0.75rem;
      color: var(--color-text-secondary);
      font-size: 1.02rem;
      line-height: 1.65;
    }

    .supporting-tools-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.85rem;
      margin-top: 0.9rem;
    }

    .supporting-tool {
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-bg);
    }

    .supporting-tool strong {
      display: block;
      color: var(--color-text);
      font-size: 0.98rem;
      line-height: 1.35;
    }

    .supporting-tool p {
      margin-top: 0.45rem;
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .evidence-list--proof {
      margin-top: 0.9rem;
    }

    .constraints-list,
    .operator-skill-list,
    .tech-stack-list,
    .learnings-list {
      list-style: none;
      padding: 0;
    }

    .constraints-list li,
    .operator-skill-list li,
    .tech-stack-list li,
    .learnings-list li {
      font-size: 1.0625rem;
      line-height: 1.7;
      padding: 0.5rem 0;
      padding-left: 1.5rem;
      position: relative;
      color: var(--color-text-secondary);
    }

    .constraints-list li::before,
    .operator-skill-list li::before,
    .tech-stack-list li::before,
    .learnings-list li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .rhythm-list,
    .architecture-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }

    .rhythm-item,
    .architecture-card,
    .evidence-item,
    .risk-item {
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background:
