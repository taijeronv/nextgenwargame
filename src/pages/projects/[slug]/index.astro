        var(--color-bg-secondary);
      padding: 1.25rem;
    }

    .rhythm-item span,
    .module-index {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }

    .rhythm-item h3,
    .architecture-card h3 {
      color: var(--color-text);
      font-size: 1.05rem;
      margin-bottom: 0.65rem;
