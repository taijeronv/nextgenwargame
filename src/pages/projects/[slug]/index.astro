    .decision-reasoning strong,
    .decision-alternatives strong {
      display: block;
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
