---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../config';
import portrait from '../assets/tj-portrait.png';
---

<BaseLayout>
  <SEO
    slot="head"
    title="About NextGen Wargame"
    description="Why NextGen Wargame exists, what CADE does, and how TJ Taijeron's military, simulation, and AI-production experience shaped the system."
    type="website"
  />
  <StructuredData type="Person" />

  <main class="about-page">
    <section class="about-hero shell">
      <p class="eyebrow">About NextGen Wargame</p>
      <h1>Training systems built from the controller’s side of the room.</h1>

      <div class="hero-grid">
        <p class="lead">
          NextGen Wargame develops low-overhead decision-training systems that help
          military staffs expose how they reason under pressure.
        </p>
        <div class="hero-summary">
          <p>
            CADE—the Combined Arms Decision Exercise—is the capstone. It creates a
            controlled cycle of context, choice, consequence, and review without
            requiring heavy simulation infrastructure.
          </p>
          <div class="hero-actions">
            <a class="button button--primary" href="/projects/cade">Explore CADE <span>↗</span></a>
            <a class="text-link" href="/projects">Review the system stack →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="founder-band">
      <div class="shell founder-grid">
        <div>
          <p class="eyebrow">Founder and designer</p>
          <h2>Vincent “TJ” Taijeron</h2>
          <Image
            class="founder-portrait"
            src={portrait}
            alt="Vincent “TJ” Taijeron, founder and designer of NextGen Wargame"
            widths={[400, 700, 1100]}
            sizes="(max-width: 900px) 80vw, 420px"
          />
        </div>
        <div class="founder-copy">
          <p class="origin">
            CADE began with a recurring training problem: leaders could see meetings,
            briefings, and products, but not always the thinking behind the recommendation.
          </p>
          <p>
            TJ designed CADE to make that reasoning visible. His role combines military
            training experience, simulation operations, controller-focused product design,
            and governed AI production.
          </p>
          <a href="https://taijeronv.info" target="_blank" rel="noopener noreferrer">
            Full biography at taijeronv.info ↗
          </a>
        </div>
      </div>

      <div class="shell evidence-grid" aria-label="CADE execution evidence">
        <div><strong>3</strong><span>Live executions</span></div>
        <div><strong>~19</strong><span>Participants per session</span></div>
        <div><strong>1 week</strong><span>First executable version</span></div>
        <div><strong>4 / 4</strong><span>First-run criteria met</span></div>
      </div>
    </section>

    <section class="credibility shell">
      <div class="section-heading">
        <p class="eyebrow">Relevant foundation</p>
        <h2>Experience connected to the design.</h2>
      </div>

      <div class="credibility-grid">
        <article>
          <span>01</span>
          <h3>Army decision context</h3>
          <p>
            Twenty years of Army service provided firsthand context for staff roles,
            commander decisions, training constraints, and the friction between functions.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Simulation operations</h3>
          <p>
            Work at the Command and General Staff College, West Point, and multinational
            training environments shaped what a lighter training system must preserve.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Multinational operations</h3>
          <p>
            NATO curriculum work and seven years with the OSCE in Ukraine added practical
            experience with language friction, incomplete information, and operational consequence.
          </p>
        </article>
        <article>
          <span>04</span>
          <h3>Governed AI production</h3>
          <p>
            Source control, acceptance criteria, review gates, and live evidence keep AI
            subordinate to the training purpose and human design authority.
          </p>
        </article>
      </div>
    </section>

    <section class="about-cta shell">
      <div>
        <p class="eyebrow">See the proof</p>
        <h2>The About page is context. CADE is the system.</h2>
        <p>
          Review the case study for the training problem, design decisions, execution
          evidence, and boundaries.
        </p>
      </div>
      <div class="cta-actions">
        <a class="button button--primary" href="/projects/cade">Open the CADE case study <span>↗</span></a>
        <a class="text-link" href={`mailto:${siteConfig.author.email}?subject=Military training or exercise problem`}>
          Discuss a training problem →
        </a>
      </div>
    </section>
  </main>

  <style>
    .shell {
      width: min(100% - 3rem, 1320px);
      margin-inline: auto;
    }

    .eyebrow {
      margin: 0;
      color: var(--color-accent);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .about-page {
      overflow: hidden;
    }

    .about-hero {
      padding-block: clamp(3.5rem, 7vw, 6rem) 4rem;
    }

    .about-hero h1 {
      max-width: 13ch;
      margin: 1.25rem 0 2.75rem;
      font-size: clamp(3.25rem, 7vw, 6.5rem);
      font-weight: 600;
      line-height: 0.94;
      letter-spacing: -0.06em;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .hero-grid .lead {
      max-width: 36rem;
      margin: 0;
      color: var(--color-text);
      font-size: clamp(1.3rem, 2.2vw, 1.85rem);
      line-height: 1.42;
    }

    .hero-summary {
      max-width: 38rem;
      justify-self: end;
    }

    .hero-summary > p {
      font-size: 1.08rem;
    }

    .hero-actions,
    .cta-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      margin-top: 1.75rem;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
      border-radius: 999px;
      padding: 0.9rem 1.15rem;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .button--primary {
      background: var(--color-text);
      color: var(--color-bg);
    }

    .button--primary:hover {
      background: var(--color-accent-dark);
      color: var(--color-bg);
    }

    .text-link {
      color: var(--color-text);
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: var(--color-highlight);
      text-underline-offset: 0.35rem;
    }

    .founder-band {
      padding-block: clamp(4rem, 8vw, 6.5rem) 0;
      background: #17211d;
      color: #f7f4eb;
    }

    .founder-grid {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
      padding-bottom: clamp(3rem, 6vw, 5rem);
    }

    .founder-band .eyebrow {
      color: var(--color-highlight);
    }

    .founder-band h2 {
      margin-top: 1rem;
      color: #f7f4eb;
      font-size: clamp(3rem, 6vw, 5.5rem);
      line-height: 0.95;
      letter-spacing: -0.055em;
    }

    .founder-portrait {
      display: block;
      width: min(100%, 420px);
      height: auto;
      margin-top: 2.5rem;
    }

    .founder-copy {
      max-width: 43rem;
    }

    .founder-copy p {
      color: #c7d0ca;
      font-size: 1.05rem;
    }

    .founder-copy .origin {
      color: #f7f4eb;
      font-size: clamp(1.25rem, 2.2vw, 1.7rem);
      line-height: 1.45;
    }

    .founder-copy a {
      color: #f7f4eb;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-color: var(--color-highlight);
      text-underline-offset: 0.35rem;
    }

    .evidence-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid #46524c;
    }

    .evidence-grid div {
      min-height: 150px;
      padding: 1.5rem;
      border-left: 1px solid #46524c;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .evidence-grid div:first-child {
      border-left: 0;
    }

    .evidence-grid strong {
      color: #f7f4eb;
      font-size: clamp(2rem, 4vw, 3.5rem);
      letter-spacing: -0.05em;
    }

    .evidence-grid span {
      margin-top: 0.5rem;
      color: #aeb9b2;
      font-size: 0.72rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .credibility {
      padding-block: clamp(5rem, 9vw, 8rem);
    }

    .section-heading {
      display: grid;
      grid-template-columns: 0.4fr 1.6fr;
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .section-heading h2,
    .about-cta h2 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(2.7rem, 6vw, 5.2rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }

    .credibility-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      border-top: 1px solid var(--color-border);
    }

    .credibility-grid article {
      min-height: 240px;
      padding: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .credibility-grid article:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }

    .credibility-grid span {
      color: var(--color-text-muted);
      font-size: 0.7rem;
      font-weight: 800;
    }

    .credibility-grid h3 {
      margin: 2.5rem 0 0.75rem;
      font-size: 1.4rem;
    }

    .credibility-grid p {
      max-width: 35rem;
      font-size: 0.95rem;
    }

    .about-cta {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      align-items: end;
      margin-bottom: 4rem;
      padding: clamp(3rem, 7vw, 6rem);
      border-radius: 2rem;
      background: #d8d2c3;
    }

    .about-cta h2 {
      margin-top: 1rem;
    }

    .about-cta p:not(.eyebrow) {
      max-width: 42rem;
      margin-top: 1.25rem;
      color: #4f554f;
    }

    .cta-actions {
      justify-content: flex-start;
      margin-top: 0;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .founder-grid,
      .section-heading,
      .about-cta {
        grid-template-columns: 1fr;
      }

      .hero-summary {
        justify-self: start;
      }

      .evidence-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .evidence-grid div:nth-child(3) {
        border-left: 0;
        border-top: 1px solid #46524c;
      }

      .evidence-grid div:nth-child(4) {
        border-top: 1px solid #46524c;
      }
    }

    @media (max-width: 560px) {
      .shell {
        width: min(100% - 2rem, 1320px);
      }

      .about-hero h1 {
        font-size: clamp(3rem, 15vw, 4.5rem);
      }

      .credibility-grid {
        grid-template-columns: 1fr;
      }

      .credibility-grid article:nth-child(even) {
        border-left: 0;
      }

      .about-cta {
        width: calc(100% - 2rem);
        padding: 2rem;
        border-radius: 1.5rem;
      }
    }
  </style>
</BaseLayout>
