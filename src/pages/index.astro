---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import heroImage from '../assets/hero-homepage-2.png';

const projects = (await getCollection('projects')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const notes = (await getCollection('fieldNotes'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout>
  <SEO slot="head" title={siteConfig.title} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" />

  <main class="home">
    <section class="hero shell">
      <p class="kicker">Military training systems · governed AI workflows</p>
      <h1>
        <span>Decision</span>
        <span class="outline">training.</span>
      </h1>

      <div class="hero-lower">
        <p class="hero-statement">Built for teams under pressure.</p>
        <div class="hero-copy">
          <p>
            NextGen Wargame turns operational source material into repeatable exercises,
            controller-ready products, and visible decision evidence—without requiring
            heavy simulation infrastructure.
          </p>
          <div class="actions">
            <a class="button button--dark" href="/projects/cade">Explore CADE <span>↗</span></a>
            <a class="text-link" href="/projects">Review systems and evidence →</a>
          </div>
        </div>
      </div>

      <Image
        class="hero-image"
        src={heroImage}
        alt="Hands drawing a route on a topographic terrain map with a marker, unit tokens placed nearby"
        widths={[640, 1024, 1600, 2400]}
        sizes="(max-width: 1320px) 100vw, 1320px"
        loading="eager"
        fetchpriority="high"
      />
    </section>

    <section class="proof-band" aria-label="CADE execution evidence">
      <div class="shell proof-grid">
        <div class="proof-intro">
          <span>Execution evidence</span>
          <p>Measured in live use—not presentation polish.</p>
        </div>
        <dl>
          <div><dt>3</dt><dd>Live executions</dd></div>
          <div><dt>~19</dt><dd>Participants per session</dd></div>
          <div><dt>1 week</dt><dd>First executable version</dd></div>
          <div><dt>4 / 4</dt><dd>First-run criteria met</dd></div>
        </dl>
      </div>
    </section>

    <section class="systems shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Systems</p>
          <h2>From source truth to execution.</h2>
        </div>
        <p>
          One training system, supported by governed production workflows. Each layer
          exists to make decisions observable and controller delivery repeatable.
        </p>
      </div>

      <div class="system-list">
        {projects.map((project, index) => (
          <a class="system-row" href={`/projects/${project.id}`}>
            <span class="system-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <span class="system-type">
                {project.data.order === 1 ? 'Capstone exercise' : project.data.order === 2 ? 'Core pipeline' : 'Supporting workflow'}
              </span>
              <h3>{project.data.title}</h3>
            </div>
            <p>{project.data.outcomeSummary}</p>
            <span class="system-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="method">
      <div class="shell method-grid">
        <div class="method-title">
          <p class="kicker">Operating method</p>
          <h2>AI accelerates production. Humans retain design authority.</h2>
        </div>
        <ol>
          <li><span>01</span><div><strong>Govern source truth</strong><p>Approved operational material constrains every downstream artifact.</p></div></li>
          <li><span>02</span><div><strong>Build bounded workflows</strong><p>AI drafts inside explicit structure, acceptance criteria, and review gates.</p></div></li>
          <li><span>03</span><div><strong>Design for controllers</strong><p>Products must work during execution without designer dependency.</p></div></li>
          <li><span>04</span><div><strong>Change from evidence</strong><p>Live observations—not model confidence—drive system revision.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="notes shell">
      <div class="section-heading section-heading--notes">
        <div>
          <p class="kicker">Field Notes</p>
          <h2>What changed in the room.</h2>
        </div>
        <a class="text-link" href="/field-notes">Read all Field Notes →</a>
      </div>
      <div class="note-grid">
        {notes.map((note, index) => (
          <a class="note-card" href={`/field-notes/${note.id}`}>
            <span>{String(index + 1).padStart(2, '0')} · {formatDate(note.data.date)}</span>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
            <strong>Read note ↗</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="contact shell">
      <p class="kicker">Start with the training problem</p>
      <h2>Need a team to make better decisions under pressure?</h2>
      <a class="button button--light" href={`mailto:${siteConfig.author.email}?subject=Military training or exercise problem`}>
        Discuss the problem <span>↗</span>
      </a>
    </section>
  </main>

  <style>
    .shell { width: min(100% - 3rem, 1320px); margin-inline: auto; }
    .home { overflow: hidden; }
    .kicker { margin: 0; color: var(--color-accent-dark); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }

    .hero { padding-block: clamp(4rem, 9vw, 8rem) 5rem; }
    .hero h1 { margin: 2rem 0 3rem; display: grid; font-size: clamp(5rem, 15vw, 13.5rem); line-height: 0.72; letter-spacing: -0.075em; font-weight: 600; }
    .hero h1 span:last-child { justify-self: end; }
    .hero h1 .outline { color: transparent; -webkit-text-stroke: 2px var(--color-text); }
    .hero-lower { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-top: 3rem; border-top: 1px solid var(--color-border); }
    .hero-statement { color: var(--color-text); font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.2; max-width: 15ch; }
    .hero-copy { max-width: 38rem; justify-self: end; }
    .hero-copy > p { font-size: clamp(1rem, 1.5vw, 1.22rem); line-height: 1.65; }
    .hero-image { display: block; width: 100%; height: auto; margin-top: clamp(3rem, 6vw, 5rem); border-radius: 2rem; }
    .actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
    .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 2.5rem; border-radius: 999px; padding: 1rem 1.35rem; font-size: 0.88rem; font-weight: 700; }
    .button--dark { color: var(--color-bg); background: var(--color-text); }
    .button--dark:hover { color: var(--color-bg); background: var(--color-accent-dark); }
    .text-link { color: var(--color-text); font-size: 0.88rem; font-weight: 700; text-decoration: underline; text-decoration-color: var(--color-highlight); text-underline-offset: 0.35rem; }

    .proof-band { color: #f7f4eb; background: #17211d; padding-block: 3.5rem; }
    .proof-grid { display: grid; grid-template-columns: 0.8fr 2.2fr; gap: 4rem; align-items: end; }
    .proof-intro span { color: var(--color-highlight); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
    .proof-intro p { color: #d7ddd9; max-width: 18rem; margin-top: 0.7rem; }
    .proof-grid dl { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
    .proof-grid dl div { border-left: 1px solid #48534d; padding-left: 1.5rem; }
    .proof-grid dt { font-size: clamp(2rem, 4vw, 4rem); font-weight: 600; letter-spacing: -0.05em; }
    .proof-grid dd { color: #adb7b1; font-size: 0.78rem; margin-top: 0.6rem; }

    .systems, .notes { padding-block: clamp(5rem, 9vw, 8rem); }
    .section-heading { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 3rem; align-items: end; margin-bottom: 4rem; }
    .section-heading h2, .method h2, .contact h2 { font-size: clamp(2.7rem, 6vw, 5.5rem); line-height: 0.98; letter-spacing: -0.055em; margin: 1rem 0 0; }
    .section-heading > p { max-width: 30rem; justify-self: end; }
    .system-list { border-top: 1px solid var(--color-border); }
    .system-row { color: var(--color-text); display: grid; grid-template-columns: 60px 1fr 1fr 32px; gap: 2rem; align-items: center; padding-block: 2rem; border-bottom: 1px solid var(--color-border); }
    .system-row:hover { color: var(--color-text); background: color-mix(in srgb, var(--color-accent) 8%, transparent); }
    .system-number, .system-type { color: var(--color-text-muted); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .system-row h3 { font-size: clamp(1.25rem, 2vw, 1.8rem); margin: 0.35rem 0 0; }
    .system-row p { font-size: 0.88rem; line-height: 1.55; margin: 0; }
    .system-arrow { font-size: 1.4rem; }

    .method { background: #d8d2c3; padding-block: clamp(5rem, 9vw, 8rem); }
    .method-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(3rem, 8vw, 8rem); }
    .method-title h2 { max-width: 11ch; }
    .method ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid #a9a394; }
    .method li { display: grid; grid-template-columns: 50px 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid #a9a394; }
    .method li > span { font-size: 0.72rem; font-weight: 800; }
    .method li strong { display: block; margin-bottom: 0.35rem; }
    .method li p { color: #4f554f; font-size: 0.9rem; margin: 0; }

    .section-heading--notes { grid-template-columns: 1fr auto; }
    .note-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .note-card { min-height: 300px; padding: 1.75rem; border: 1px solid var(--color-border); border-radius: 1.5rem; color: var(--color-text); display: flex; flex-direction: column; }
    .note-card:hover { color: var(--color-text); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .note-card > span { color: var(--color-text-muted); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
    .note-card h3 { font-size: 1.45rem; margin: 2.5rem 0 1rem; }
    .note-card p { font-size: 0.9rem; }
    .note-card strong { margin-top: auto; font-size: 0.78rem; }

    .contact { margin-bottom: 4rem; border-radius: 2rem; background: #17211d; color: #f7f4eb; padding: clamp(3rem, 7vw, 6rem); display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: end; }
    .contact .kicker { grid-column: 1 / -1; color: var(--color-highlight); }
    .contact h2 { color: #f7f4eb; max-width: 11ch; }
    .button--light { color: #17211d; background: #f7f4eb; }
    .button--light:hover { color: #17211d; background: var(--color-highlight); }

    @media (max-width: 900px) {
      .hero-lower, .proof-grid, .section-heading, .method-grid, .contact { grid-template-columns: 1fr; }
      .hero-copy, .section-heading > p { justify-self: start; }
      .proof-grid dl { grid-template-columns: repeat(2, 1fr); gap: 2rem 0; }
      .system-row { grid-template-columns: 44px 1fr 24px; gap: 1rem; }
      .system-row > p { grid-column: 2 / -1; }
      .note-grid { grid-template-columns: 1fr; }
      .note-card { min-height: 240px; }
    }

    @media (max-width: 560px) {
      .shell { width: min(100% - 2rem, 1320px); }
      .hero { padding-top: 4rem; }
      .hero h1 { font-size: clamp(4.2rem, 23vw, 7rem); line-height: 0.78; margin-block: 1.5rem 2rem; }
      .hero h1 span:last-child { justify-self: start; }
      .hero h1 .outline { -webkit-text-stroke-width: 1px; }
      .proof-grid dl { grid-template-columns: 1fr 1fr; }
      .proof-grid dl div { padding-left: 1rem; }
      .section-heading { margin-bottom: 2.5rem; }
      .system-row { padding-block: 1.5rem; }
      .contact { width: calc(100% - 2rem); padding: 2rem; border-radius: 1.5rem; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .note-card, .system-row { transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease; }
    }
  </style>
</BaseLayout>
