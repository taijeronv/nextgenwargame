---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DecisionCard from '../components/DecisionCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured || project.data.relatedProjects?.includes('cade'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const cadeProject = allProjects.find((project) => project.id === 'cade');
const proofSignals = cadeProject?.data.proof ?? cadeProject?.data.evidence ?? [];
const buildSteps = [
  'Name the real problem',
  'Keep the facts straight',
  'Build the working tool',
  'Try it with real people',
  'Fix what the trial exposes',
];
const cadeTurn = [
  {
    label: 'Situation',
    text: 'Give the staff just enough of the story to act.',
  },
  {
    label: 'Decision',
    text: 'Force a choice. No hiding in endless discussion.',
  },
  {
    label: 'Reason',
    text: 'Capture why they chose it and what risk they accepted.',
  },
  {
    label: 'Result',
    text: 'Show the consequence and use it for coaching.',
  },
];

const allDecisions = await getCollection('decisions');
const recentDecisions = allDecisions
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<BaseLayout>
  <SEO
    slot="head"
    title={siteConfig.title}
    description={siteConfig.description}
    type="website"
    noSuffix
  />
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <p class="eyebrow">CADE · Combined Arms Decision Exercise</p>
          <h1 class="hero-title">
            CADE is a pressure test for staff decisions.
          </h1>
          <p class="hero-sub">
            It gives a team a realistic problem, a short clock, and no perfect answer. They must choose, explain the tradeoff, see the result, and learn from what their reasoning missed.
          </p>
          <p class="hero-sub hero-sub--plain">
            I designed and built CADE so leaders can see decision quality quickly: what the planning team noticed, what it ignored, what risk it accepted, and whether the recommendation made sense under pressure.
          </p>
          <p class="hero-meta">
            {siteConfig.author.name} · {siteConfig.author.title}
          </p>
          <div class="hero-cta">
            <a href="/projects/cade" class="btn-primary">Read the CADE case study</a>
            <a href="/methods" class="btn-secondary">See how I built it</a>
          </div>
        </div>

        <div class="hero-right" aria-label="CADE proof points">
          <div class="proof-panel">
            <span class="proof-label">What it is</span>
            <strong>A repeatable decision exercise</strong>
            <p>Each turn asks for four things: a decision, the reason behind it, the result, and one lesson for review.</p>
          </div>
          <div class="proof-panel">
            <span class="proof-label">What it is not</span>
            <strong>Not a simulator. Not an AI black box.</strong>
            <p>CADE does not try to model every battlefield variable. It makes human judgment visible, and humans control the design and validation.</p>
          </div>
          <div class="proof-panel">
            <span class="proof-label">What I proved</span>
            <strong>Three live runs · about 19 people per session</strong>
            <p>I built the first executable version in one week, then improved it from what happened in the room.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-block cade-definition">
      <div>
        <p class="eyebrow">In plain English</p>
        <h2>What Is CADE?</h2>
        <p>
          CADE is a way to find out how a staff thinks before the stakes are real. In plain terms, the staff is the planning team, and the controller is the facilitator running the exercise. The controller gives the team a changing situation. The team has to make a choice, explain its reasoning, accept the cost, and carry the consequence into the next turn.
        </p>
        <p>
          The important part is not whether they guessed the “right” answer. The important part is whether their thinking was clear enough to inspect, coach, and improve.
        </p>
      </div>
      <div class="turn-card">
        <span class="proof-label">One CADE turn</span>
        <div class="turn-grid">
          {cadeTurn.map((step, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step.label}</strong>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-block process-section">
      <div class="section-header">
        <h2>How I Work</h2>
        <ForwardLink href="/methods" text="Read methods" variant="muted" />
      </div>
      <p class="section-intro">
        My role is to turn a fuzzy problem into a tool people can actually use. AI helps me move faster, but it does not decide what the product should be.
      </p>
      <div class="process-grid">
        {buildSteps.map((step, index) => (
          <article class="process-step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2>More Than One Page Of Claims</h2>
        <ForwardLink href="/projects" text="View all" variant="muted" />
      </div>
      <p class="section-intro">
        CADE is the main case. The supporting projects show the machinery behind it: how source material stayed consistent, how controller documents were built, and how incomplete inputs were turned into usable training products.
      </p>
      <div class="card-list">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            year={project.data.year}
            techStack={project.data.techStack}
            featured={project.data.featured}
            status={project.data.status}
          />
        ))}
      </div>
    </section>

    <section class="section-block proof-format-section">
      <div class="section-header">
        <h2>What I Want A Recruiter To See</h2>
        <ForwardLink href="/projects/cade" text="See it applied" variant="muted" />
      </div>
      <p class="section-intro">
        This is not a site about buzzwords. It is a site about whether I can take an unclear, high-pressure problem and make a working product out of it.
      </p>
      <div class="proof-format-grid">
        <article>
          <span>01</span>
          <strong>I can simplify a hard problem without making it stupid.</strong>
        </article>
        <article>
          <span>02</span>
          <strong>I can use AI as a fast workbench, not as a substitute for judgment.</strong>
        </article>
        <article>
          <span>03</span>
          <strong>I can build something people can run without me standing beside it.</strong>
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2>CADE As The Proof</h2>
        <ForwardLink href="/projects/cade" text="Read CADE" variant="muted" />
      </div>
      <p class="section-intro">
        The claim is simple: I can design the logic, use AI to accelerate the work, test the result with real users, and improve the product from evidence instead of opinion.
      </p>
      <div class="evidence-grid">
        {proofSignals.slice(0, 4).map((item) => (
          <article class="evidence-tile">
            <strong>{item.label}</strong>
            <p>{item.result}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2>How I Kept AI In Its Lane</h2>
        <ForwardLink href="/decisions" text="View all" variant="muted" />
      </div>
      <p>
        AI helped draft, compare, revise, and produce materials quickly. I kept control of the problem, the source facts, the training logic, the review standard, and the final product.
      </p>
      <div class="card-list card-list--compact">
        {recentDecisions.map((decision) => (
          <DecisionCard
            title={decision.data.title}
            slug={decision.id}
            context={decision.data.context}
            date={decision.data.date}
            tags={decision.data.tags}
          />
        ))}
      </div>
    </section>

    <section id="contact" class="cta">
      <h2>Talk About Practical AI Product Work</h2>
      <p>
        Reach out if you want someone who can explain a hard problem plainly, build with AI carefully, and ship something that works outside a demo.
      </p>
      <a href={`mailto:${siteConfig.author.email}`} class="btn-primary">{siteConfig.author.email}</a>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 4rem 0 5rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 4rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
      gap: 4rem;
      align-items: start;
    }

    .eyebrow,
    .proof-label {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(2.25rem, 6vw, 4.8rem);
      line-height: 1.02;
      font-weight: 750;
      letter-spacing: -0.055em;
      margin-bottom: 1.5rem;
      color: var(--color-text);
    }

    .hero-sub {
      font-size: 1.25rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
      max-width: 680px;
      margin-bottom: 1rem;
    }

    .hero-sub--plain {
      color: var(--color-text);
      font-size: 1.08rem;
    }

    .hero-meta {
      color: var(--color-text-muted);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .btn-primary,
    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.1rem;
      border-radius: 6px;
      font-weight: 650;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--color-text);
      color: var(--color-bg);
    }

    .btn-secondary {
      border: 1px solid var(--color-border);
      color: var(--color-text);
    }

    .hero-right {
      display: grid;
      gap: 1rem;
    }

    .proof-panel {
      padding: 1.25rem;
      background:
        linear-gradient(135deg, rgba(59, 130, 246, 0.08), transparent),
        var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 12px;
    }

    .cade-definition {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
      gap: 2rem;
      padding: 2rem;
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background:
        radial-gradient(circle at 12% 12%, rgba(251, 191, 36, 0.14), transparent 22rem),
        linear-gradient(135deg, rgba(59, 130, 246, 0.1), transparent 38rem),
        var(--color-bg-secondary);
    }

    .cade-definition h2 {
      color: var(--color-text);
      font-size: clamp(2rem, 5vw, 3.4rem);
      line-height: 1;
      letter-spacing: -0.045em;
      margin-bottom: 1rem;
    }

    .cade-definition p {
      color: var(--color-text-secondary);
      font-size: 1.05rem;
      line-height: 1.75;
      margin-bottom: 1rem;
    }

    .turn-card {
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: rgba(10, 15, 25, 0.5);
    }

    .turn-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .turn-grid article {
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.025);
    }

    .turn-grid span {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
    }

    .turn-grid strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.45rem;
    }

    .turn-grid p {
      color: var(--color-text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
      margin: 0;
    }

    .process-section {
      padding: 2rem;
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background:
        radial-gradient(circle at top left, rgba(251, 191, 36, 0.12), transparent 30rem),
        var(--color-bg-secondary);
    }

    .process-grid,
    .proof-format-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .process-step,
    .proof-format-grid article {
      min-height: 120px;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: rgba(10, 15, 25, 0.42);
    }

    .process-step span,
    .proof-format-grid span {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }

    .process-step strong,
    .proof-format-grid strong {
      display: block;
      color: var(--color-text);
      line-height: 1.35;
      font-size: 1rem;
    }

    .proof-format-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof-format-section .proof-format-grid article {
      min-height: 150px;
    }

    .architecture-strip {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border: 1px solid var(--color-border);
      border-radius: 14px;
      overflow: hidden;
      background: var(--color-bg-secondary);
    }

    .architecture-tile {
      min-height: 210px;
      padding: 1.25rem;
      border-right: 1px solid var(--color-border);
      background:
        linear-gradient(180deg, rgba(59, 130, 246, 0.08), transparent 62%),
        var(--color-bg-secondary);
    }

    .architecture-tile:last-child {
      border-right: 0;
    }

    .architecture-tile span {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }

    .architecture-tile h3 {
      color: var(--color-text);
      font-size: 1rem;
      line-height: 1.35;
      margin-bottom: 0.8rem;
    }

    .architecture-tile p,
    .evidence-tile p {
      color: var(--color-text-secondary);
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .evidence-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }

    .rhythm-rail {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .rhythm-step {
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-bg-secondary);
    }

    .rhythm-step span {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      margin-bottom: 0.85rem;
    }

    .rhythm-step strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.55rem;
    }

    .rhythm-step p {
      color: var(--color-text-secondary);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    .fit-section {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2rem;
      padding: 2rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-bg-secondary);
    }

    .fit-section h2 {
      font-size: 1.75rem;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .fit-section p {
      color: var(--color-text-secondary);
      line-height: 1.75;
    }

    .fit-section ul {
      list-style: none;
      display: grid;
      gap: 0.75rem;
      padding: 0;
    }

    .fit-section li {
      color: var(--color-text-secondary);
      line-height: 1.6;
      padding-left: 1.35rem;
      position: relative;
    }

    .fit-section li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .evidence-tile {
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-bg-secondary);
    }

    .evidence-tile strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.65rem;
      line-height: 1.4;
    }

    .proof-panel strong {
      display: block;
      color: var(--color-text);
      font-size: 1.05rem;
      margin-bottom: 0.5rem;
    }

    .proof-panel p,
    .section-intro {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .section-block {
      margin-bottom: 4.5rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .section-header h2,
    .thinking h2,
    .cta h2 {
      font-size: 1.75rem;
      letter-spacing: -0.02em;
      margin: 0;
    }

    .section-intro {
      max-width: 760px;
      margin-bottom: 1.5rem;
    }

    .thinking,
    .cta {
      padding: 2rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-bg-secondary);
      margin-bottom: 3rem;
    }

    .thinking p,
    .cta p {
      color: var(--color-text-secondary);
      line-height: 1.8;
      margin: 1rem 0 1.5rem;
    }

    @media (max-width: 860px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .architecture-strip,
      .evidence-grid,
      .rhythm-rail,
      .cade-definition,
      .turn-grid,
      .process-grid,
      .proof-format-grid,
      .fit-section {
        grid-template-columns: 1fr;
      }

      .architecture-tile {
        min-height: auto;
        border-right: 0;
        border-bottom: 1px solid var(--color-border);
      }

      .architecture-tile:last-child {
        border-bottom: 0;
      }

      .section-header {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
