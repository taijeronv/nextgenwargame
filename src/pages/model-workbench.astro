---
import PageLayout from '../layouts/PageLayout.astro';
import SEO from '../components/SEO.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('workbenchNotes');
const sortedNotes = notes.sort((a, b) => {
  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }
  return (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0);
});

const pageTitle = 'Model Workbench';
const pageDescription =
  'Notes from the field building with AI: short practical notes on models, CADE, AI-assisted development, and human judgment.';
---

<PageLayout>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    type="website"
  />

  <section class="workbench-hero">
    <p class="eyebrow">Model Workbench</p>
    <h1>Notes from the field building with AI.</h1>
    <p class="lead">
      This is the place for short notes about how I actually use models: not as a magic answer machine, but as a workbench for thinking, drafting, testing, and building.
    </p>
  </section>

  <section class="workbench-entries" aria-label="Workbench notes">
    <p class="eyebrow">Workbench Notes</p>
    <div class="note-grid">
      {sortedNotes.map((note) => (
        <article class="workbench-entry">
          <div class="entry-index">{String(note.data.order).padStart(2, '0')}</div>
          <div>
            <header class="entry-header">
              {note.data.date && (
                <time class="entry-date" datetime={note.data.date.toISOString()}>
                  {note.data.date.toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
              )}
              <h2>
                <a href={`/model-workbench/${note.id}`}>{note.data.title}</a>
              </h2>
            </header>
            <p>{note.data.description}</p>
            <ForwardLink href={`/model-workbench/${note.id}`} text="Read note" />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="workbench-cta">
    <div>
      <h2>Back to the work</h2>
      <p>
        The notes are the workshop. CADE is the proof that the workshop can produce something usable.
      </p>
    </div>
    <ForwardLink href="/projects/cade" text="Read the CADE case study" />
  </section>
</PageLayout>

<style>
  .workbench-hero {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .workbench-hero h1 {
    font-size: clamp(2.5rem, 8vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    margin-bottom: 1.5rem;
  }

  .lead {
    color: var(--color-text-secondary);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
    max-width: 68ch;
  }

  .workbench-entries {
    margin-bottom: 3rem;
  }

  .workbench-entries > .eyebrow {
    margin-bottom: 1.5rem;
  }

  .note-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .workbench-entry {
    display: grid;
    grid-template-columns: 2.35rem minmax(0, 1fr);
    gap: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg-elevated);
    padding: 1rem;
  }

  .entry-index {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .entry-header {
    margin-bottom: 0.55rem;
  }

  .entry-date {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.55rem;
  }

  .entry-header h2 {
    font-size: 1.08rem;
    line-height: 1.18;
    letter-spacing: 0;
    margin: 0;
  }

  .entry-header h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .entry-header h2 a:hover {
    color: var(--color-accent);
  }

  .workbench-entry p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 0.85rem;
  }

  .workbench-cta {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg-elevated);
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
  }

  .workbench-cta h2 {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .workbench-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  @media (max-width: 760px) {
    .note-grid {
      grid-template-columns: 1fr;
    }

    .workbench-entry {
      grid-template-columns: 2.15rem minmax(0, 1fr);
    }

    .workbench-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
