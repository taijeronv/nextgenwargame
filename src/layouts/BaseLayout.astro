---
/**
 * BaseLayout
 * 
 * Foundation layout component that provides the core HTML structure,
 * navigation, footer, and global styles for all pages. All other layouts extend
 * this base layout to ensure consistent site-wide structure.
 * 
 * Features:
 * - HTML document structure
 * - Favicon and manifest configuration
 * - Astro View Transitions support with theme persistence
 * - Sticky responsive navigation header
 * - Keyboard skip link and valid landmark structure
 * - Global CSS imports (global, typography, utilities)
 * - Responsive layout structure
 * 
 * Note: SEO meta tags (title, description, OG, Twitter) should be handled
 * by the SEO component in each page, not in this layout.
 * 
 * @component
 * 
 * @example
 * ```astro
 * ---
 * import BaseLayout from '../layouts/BaseLayout.astro';
 * import SEO from '../components/SEO.astro';
 * ---
 * 
 * <BaseLayout>
 *   <SEO 
 *     slot="head"
 *     title="About Me" 
 *     description="Learn more about my background"
 *   />
 *   <div>Page content goes here</div>
 * </BaseLayout>
 * ```
 */

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/utilities.css';
---

<!DOCTYPE html>
<html lang={siteConfig.language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO tags injected via slot -->
    <slot name="head" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#f2f0e9" />
    
    <ClientRouter />
    
    <style>
      body {
        min-height: 100vh;
      }

      .page-body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .site-main {
        flex: 1;
      }

      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 1000;
        padding: 0.75rem 1rem;
        border-radius: 999px;
        background: var(--color-text);
        color: var(--color-bg);
        font-weight: 700;
        transform: translateY(-200%);
        transition: transform 150ms ease;
      }

      .skip-link:focus {
        color: var(--color-bg);
        transform: translateY(0);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <div class="page-body">
      <div class="site-main" id="main-content" tabindex="-1">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
